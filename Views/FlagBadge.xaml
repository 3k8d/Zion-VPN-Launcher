<UserControl x:Class="Zion.Views.FlagBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="26" Height="18" VerticalAlignment="Center">
    <Border CornerRadius="4" BorderBrush="#33FFFFFF" BorderThickness="1" ClipToBounds="True" Background="#1A1D2B">
        <Grid>
            <!-- 1. Fallback Globe -->
            <TextBlock x:Name="GlobeFallback" Text="🌐" FontSize="11"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- 2. Embedded Resource High-Res Flag PNG -->
            <Image x:Name="FlagImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>

