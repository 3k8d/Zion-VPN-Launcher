<!-- Sites that bypass the VPN -->
<UserControl x:Class="Zion.Views.Screens.ExcludedSitesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Zion.Views.Controls"
             Style="{StaticResource ScreenHost}">
    <UserControl.RenderTransform>
        <TranslateTransform/>
    </UserControl.RenderTransform>

    <Grid Margin="18,16,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconBtn}" Command="{Binding ExcludedSitesVm.BackCommand}" Margin="0,0,12,0" ToolTip="Назад к настройкам">
                    <Path Data="M 5 0 L 0 5 L 5 10" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <TextBlock Text="Сайты мимо VPN" Style="{StaticResource ScreenTitle}"/>
                <Border Style="{StaticResource Pill}" Margin="9,1,0,0">
                    <TextBlock Text="{Binding ExcludedSitesVm.Count}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentHi}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <controls:WindowButtons/>
            </StackPanel>
        </DockPanel>

        <!-- Add a site -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Height="40" Tag="Адрес сайта, например kinopoisk.ru"
                         Text="{Binding ExcludedSitesVm.NewSite, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ExcludedSitesVm.AddCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <!-- Empty field: one click takes the address from the clipboard -->
                <Button Grid.Column="1" Height="40" MinWidth="104" Margin="8,0,0,0" Padding="14,0"
                        Command="{Binding ExcludedSitesVm.AddCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
                            <Setter Property="Content" Value="Добавить"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExcludedSitesVm.HasNewSite}" Value="False">
                                    <Setter Property="Content" Value="Вставить"/>
                                    <Setter Property="ToolTip" Value="Вставить адрес из буфера обмена и добавить"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <TextBlock Text="{Binding ExcludedSitesVm.Status}" FontSize="11.5" TextWrapping="Wrap" Margin="4,8,0,0"
                       Visibility="{Binding ExcludedSitesVm.HasStatus, Converter={StaticResource BoolToVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource AccentHi}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ExcludedSitesVm.StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ExcludedSitesVm.Rows}" Margin="0,0,4,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                    CornerRadius="14" Padding="12,10,8,10" Margin="0,0,0,8">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource RowAction}" ToolTip="Вернуть в VPN" VerticalAlignment="Center">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding RemoveCommand}"/>
                                        </Border.InputBindings>
                                        <Path Data="M 0 0 L 8 8 M 8 0 L 0 8" Stroke="{StaticResource Danger}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GlassHover}" Margin="0,0,12,0">
                                        <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource AccentHi}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm6.93 6h-2.95c-.32-1.25-.78-2.45-1.38-3.56 1.84.63 3.37 1.91 4.33 3.56zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2 0 .68.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56-1.84-.63-3.37-1.9-4.33-3.56zm2.95-8H5.08c.96-1.66 2.49-2.93 4.33-3.56C8.81 5.55 8.35 6.75 8.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.09-.66-.16-1.32-.16-2 0-.68.07-1.35.16-2h4.68c.09.65.16 1.32.16 2 0 .68-.07 1.34-.16 2zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95c-.96 1.65-2.49 2.93-4.33 3.56zM16.36 14c.08-.66.14-1.32.14-2 0-.68-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,40" IsHitTestVisible="False"
                        Visibility="{Binding ExcludedSitesVm.IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Пока все сайты идут через VPN" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="Поддомены добавляются автоматически." FontSize="11.5" Foreground="{StaticResource TextMuted}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
