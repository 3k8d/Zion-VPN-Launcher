<!-- Add or edit a server: share link, fields per protocol -->
<UserControl x:Class="Zion.Views.Screens.ServerEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Zion.Views.Controls"
             Style="{StaticResource ScreenHost}">
    <UserControl.RenderTransform>
        <TranslateTransform/>
    </UserControl.RenderTransform>

    <Grid Margin="18,16,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconBtn}" Command="{Binding OpenServerListCommand}" Margin="0,0,12,0" ToolTip="Назад к списку">
                    <Path Data="M 5 0 L 0 5 L 5 10" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <TextBlock Text="{Binding EditFormTitle}" Style="{StaticResource ScreenTitle}" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <controls:WindowButtons/>
            </StackPanel>
        </DockPanel>

        <!-- Quick import / export -->
        <Border Grid.Row="1" Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                CornerRadius="16" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,2">
                    <TextBlock x:Name="EditCopyToastText" Text="✓ Скопировано" Foreground="{StaticResource Success}" FontWeight="SemiBold" FontSize="11"
                               DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock Text="Ссылка сервера" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="12.5"/>
                </DockPanel>
                <TextBlock Text="Вставьте готовую ссылку или скопируйте текущую" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,9"/>
                <TextBox x:Name="EditQuickInputTextBox" Tag="vless://, trojan://, ss://, vmess://, hysteria2://, tuic://, подписка https://..."
                         TextChanged="EditQuickInputTextBox_TextChanged" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource TonalBtn}" Height="32" Content="Вставить" Click="EditPasteFromClipboard_Click"/>
                    <Button Grid.Column="2" Style="{StaticResource GhostBtn}" Height="32" FontSize="12" Content="Скопировать" Click="EditCopyLink_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Название" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="EditNameTextBox" Tag="например: Германия #1 или США" TextChanged="OnEditFormFieldChanged" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.8*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Хост / IP" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="EditHostTextBox" Tag="vpn.example.com" TextChanged="EditHostTextBox_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Порт" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="EditPortTextBox" Tag="443" TextChanged="OnEditFormFieldChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Протокол" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="EditProtocolComboBox" SelectionChanged="EditProtocolComboBox_SelectionChanged">
                            <ComboBoxItem Content="VLESS" IsSelected="True"/>
                            <ComboBoxItem Content="Trojan"/>
                            <ComboBoxItem Content="Shadowsocks"/>
                            <ComboBoxItem Content="VMess"/>
                            <ComboBoxItem Content="Hysteria2"/>
                            <ComboBoxItem Content="TUIC"/>
                            <ComboBoxItem Content="SOCKS5"/>
                            <ComboBoxItem Content="HTTP"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="EditVlessPanel">
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Ключ пользователя (UUID)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="EditUuidTextBox" Tag="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" TextChanged="OnEditFormFieldChanged"/>
                    </StackPanel>

                    <Border Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            CornerRadius="16" Padding="12,12,12,4" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="СЕТЬ И МАСКИРОВКА" Style="{StaticResource Overline}" Foreground="{StaticResource AccentHi}" Margin="2,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Транспорт" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="EditTransportComboBox" SelectionChanged="OnEditFormFieldChanged">
                                        <ComboBoxItem Content="TCP" IsSelected="True"/>
                                        <ComboBoxItem Content="gRPC"/>
                                        <ComboBoxItem Content="WebSocket (WS)"/>
                                        <ComboBoxItem Content="HTTPUpgrade"/>
                                        <ComboBoxItem Content="H2"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Безопасность" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="EditSecurityComboBox" SelectionChanged="OnEditFormFieldChanged">
                                        <ComboBoxItem Content="Reality" IsSelected="True"/>
                                        <ComboBoxItem Content="TLS"/>
                                        <ComboBoxItem Content="None"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Отпечаток (FP)" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="EditFingerprintComboBox" SelectionChanged="OnEditFormFieldChanged">
                                        <ComboBoxItem Content="Chrome" IsSelected="True"/>
                                        <ComboBoxItem Content="Firefox"/>
                                        <ComboBoxItem Content="Safari"/>
                                        <ComboBoxItem Content="Edge"/>
                                        <ComboBoxItem Content="iOS"/>
                                        <ComboBoxItem Content="Random"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Сайт маскировки (SNI)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EditSniTextBox" Tag="yahoo.com" TextChanged="OnEditFormFieldChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Публичный ключ (PBK)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EditPublicKeyTextBox" Tag="Public Key" TextChanged="OnEditFormFieldChanged"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Короткий ID (ShortId)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EditShortIdTextBox" Tag="Short ID" TextChanged="OnEditFormFieldChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Служба / Путь" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EditServiceOrPathTextBox" Tag="ServiceName / Path" TextChanged="OnEditFormFieldChanged"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="EditAuthPanel" Visibility="Collapsed">
                    <TextBlock Text="АВТОРИЗАЦИЯ (НЕОБЯЗАТЕЛЬНО)" Style="{StaticResource Overline}" Foreground="{StaticResource AccentHi}" Margin="2,2,0,10"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Логин" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EditUserTextBox" Tag="Логин" TextChanged="OnEditFormFieldChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EditPassTextBox" Tag="Пароль" TextChanged="OnEditFormFieldChanged"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Hysteria2 / TUIC -->
                <StackPanel x:Name="EditQuicPanel" Visibility="Collapsed">
                    <UniformGrid Rows="1" Margin="0,0,0,10">
                        <StackPanel x:Name="EditTuicUuidPanel" Margin="0,0,8,0">
                            <TextBlock Text="Ключ пользователя (UUID)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EditTuicUuidTextBox" Tag="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" TextChanged="OnEditFormFieldChanged"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EditQuicPasswordTextBox" Tag="Пароль" TextChanged="OnEditFormFieldChanged"/>
                        </StackPanel>
                    </UniformGrid>

                    <Border Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            CornerRadius="16" Padding="12,12,12,4" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="СОЕДИНЕНИЕ" Style="{StaticResource Overline}" Foreground="{StaticResource AccentHi}" Margin="2,0,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Сайт маскировки (SNI)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EditQuicSniTextBox" Tag="example.com" TextChanged="OnEditFormFieldChanged"/>
                                </StackPanel>
                                <StackPanel x:Name="EditObfsPanel" Grid.Column="1">
                                    <TextBlock Text="Пароль обфускации" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EditObfsPasswordTextBox" Tag="Salamander" TextChanged="OnEditFormFieldChanged"/>
                                </StackPanel>
                                <StackPanel x:Name="EditCongestionPanel" Grid.Column="1" Visibility="Collapsed">
                                    <TextBlock Text="Контроль перегрузки" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="EditCongestionComboBox" SelectionChanged="OnEditFormFieldChanged">
                                        <ComboBoxItem Content="BBR" IsSelected="True"/>
                                        <ComboBoxItem Content="Cubic"/>
                                        <ComboBoxItem Content="New_Reno"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="EditHopPortsPanel" Margin="0,0,0,8">
                                <TextBlock Text="Диапазон портов" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="EditHopPortsTextBox" Tag="20000-30000" TextChanged="OnEditFormFieldChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.6*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource GhostBtn}" Height="42" Content="Отмена" Command="{Binding OpenServerListCommand}"/>
            <Button Grid.Column="2" Style="{StaticResource PrimaryBtn}" Height="42" Content="Сохранить" Click="BtnSaveServer_Click"/>
        </Grid>
    </Grid>
</UserControl>
