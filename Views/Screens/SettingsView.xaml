<!-- Settings -->
<UserControl x:Class="Zion.Views.Screens.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Zion.Views.Controls"
             Style="{StaticResource ScreenHost}">
    <UserControl.RenderTransform>
        <TranslateTransform/>
    </UserControl.RenderTransform>

    <Grid Margin="18,16,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconBtn}" Command="{Binding ShowDashboardCommand}" Margin="0,0,12,0" ToolTip="Назад на главный экран">
                    <Path Data="M 5 0 L 0 5 L 5 10" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <TextBlock Text="Настройки" Style="{StaticResource ScreenTitle}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <controls:WindowButtons/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="ПОДКЛЮЧЕНИЕ" Style="{StaticResource Overline}" Margin="4,2,0,8"/>
                <CheckBox Style="{StaticResource SettingRow}"
                          Content="Автопереключение сервера"
                          Tag="Переход на другой сервер, если текущий недоступен"
                          IsChecked="{Binding AutoServerFailover}"/>


                <TextBlock Text="ИСКЛЮЧЕНИЯ" Style="{StaticResource Overline}" Margin="4,10,0,8"/>
                <Button Style="{StaticResource CardButton}" Command="{Binding OpenExclusionsCommand}" Margin="0,0,0,8" Padding="14,12">
                    <DockPanel>
                        <Path DockPanel.Dock="Right" Data="M 0 0 L 5 5 L 0 10" Stroke="{StaticResource TextMuted}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Программы мимо VPN" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{Binding ExcludedAppsVm.Summary}" FontSize="11" Foreground="{StaticResource TextMuted}"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource CardButton}" Command="{Binding OpenExcludedSitesCommand}" Margin="0,0,0,8" Padding="14,12">
                    <DockPanel>
                        <Path DockPanel.Dock="Right" Data="M 0 0 L 5 5 L 0 10" Stroke="{StaticResource TextMuted}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Сайты мимо VPN" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{Binding ExcludedSitesVm.Summary}" FontSize="11" Foreground="{StaticResource TextMuted}"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Button>

                <TextBlock Text="ЗАЩИТА" Style="{StaticResource Overline}" Margin="4,10,0,8"/>
                <CheckBox Style="{StaticResource SettingRow}"
                          Content="Блокировать WebRTC"
                          Tag="Запрет STUN-запросов браузера"
                          IsChecked="{Binding BlockWebRtc}"/>
                <CheckBox Style="{StaticResource SettingRow}"
                          Content="Блокировать QUIC"
                          Tag="Сайты работают через HTTPS вместо QUIC"
                          IsChecked="{Binding BlockQuic}"/>
                <CheckBox Style="{StaticResource SettingRow}"
                          Content="Блокировать трекеры"
                          Tag="Блокировка аналитики и рекламных сетей"
                          IsChecked="{Binding BlockTrackers}"/>


                <TextBlock Text="ДИАГНОСТИКА" Style="{StaticResource Overline}" Margin="4,18,0,8"/>
                <Border Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                        CornerRadius="16" Padding="14,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource TonalBtn}" Height="32" FontSize="11.5"
                                MinWidth="104" VerticalAlignment="Center" Margin="14,0,0,0"
                                Content="{Binding CopyLogsButtonText}" Command="{Binding CopyLogsCommand}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Журнал событий" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Подключения, ошибки и смены серверов"
                                       FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
