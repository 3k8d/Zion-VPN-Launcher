<!-- Subscriptions: any number of links, plan and quota per link -->
<UserControl x:Class="Zion.Views.Screens.SubscriptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Zion.Views.Controls"
             Style="{StaticResource ScreenHost}">
    <UserControl.RenderTransform>
        <TranslateTransform/>
    </UserControl.RenderTransform>

    <Grid Margin="18,16,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconBtn}" Command="{Binding SubscriptionsVm.BackCommand}" Margin="0,0,12,0" ToolTip="Назад к серверам">
                    <Path Data="M 5 0 L 0 5 L 5 10" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <TextBlock Text="Подписки" Style="{StaticResource ScreenTitle}"/>
                <Border Style="{StaticResource Pill}" Margin="9,1,0,0">
                    <TextBlock Text="{Binding SubscriptionsVm.Count}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentHi}"/>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource IconBtn}" ToolTip="Обновить все подписки" Margin="0,0,8,0"
                        Command="{Binding SubscriptionsVm.RefreshAllCommand}">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                </Button>
                <controls:WindowButtons/>
            </StackPanel>
        </DockPanel>

        <!-- Add a link -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Height="40" Tag="Ссылка на подписку: https://…"
                         Text="{Binding SubscriptionsVm.NewUrl, UpdateSourceTrigger=PropertyChanged}"/>
                <!-- Empty field: one click pastes from the clipboard; with text: adds it -->
                <Button Grid.Column="1" Height="40" MinWidth="104" Margin="8,0,0,0" Padding="14,0"
                        Command="{Binding SubscriptionsVm.AddCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
                            <Setter Property="Content" Value="Добавить"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SubscriptionsVm.HasNewUrl}" Value="False">
                                    <Setter Property="Content" Value="Вставить"/>
                                    <Setter Property="ToolTip" Value="Вставить ссылку из буфера обмена и добавить"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SubscriptionsVm.IsAdding}" Value="True">
                                    <Setter Property="Content" Value="Загрузка…"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <TextBlock Text="{Binding SubscriptionsVm.Status}" FontSize="11.5" TextWrapping="Wrap" Margin="4,8,0,0"
                       Visibility="{Binding SubscriptionsVm.HasStatus, Converter={StaticResource BoolToVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SubscriptionsVm.StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- The list -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SubscriptionsVm.Rows}" Margin="0,0,4,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                    CornerRadius="16" Padding="14,12,10,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Host}" FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Margin="0,9,0,0" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                                            <Grid Height="4" Margin="0,0,0,6" Visibility="{Binding HasQuota, Converter={StaticResource BoolToVis}}">
                                                <Border CornerRadius="2" Background="#1FFFFFFF"/>
                                                <Border CornerRadius="2" RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding UsedFraction}"/>
                                                    </Border.RenderTransform>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PlanWarning}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource Danger}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding PlanText}" FontSize="11" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlanWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource IconBtn}" Width="30" Height="30" Margin="0,0,6,0"
                                                ToolTip="Обновить" Command="{Binding RefreshCommand}">
                                            <Path Width="12" Height="12" Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                                        </Button>
                                        <!-- Delete: first click arms it (turns into a red "Удалить?"), the second removes -->
                                        <Button Width="30" Height="30" ToolTip="Удалить подписку" Command="{Binding DeleteCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconBtnDanger}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDeleteArmed}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Width="11" Height="12" Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                        </Button>
                                        <Button Style="{StaticResource DangerBtn}" Height="30" FontSize="11.5" Padding="12,0" MinWidth="84"
                                                Content="Удалить?" ToolTip="Нажмите ещё раз, чтобы удалить подписку и её серверы"
                                                Command="{Binding DeleteCommand}"
                                                Visibility="{Binding IsDeleteArmed, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- No subscriptions yet -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,40" IsHitTestVisible="False"
                        Visibility="{Binding SubscriptionsVm.IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Подписок пока нет" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Скопируйте ссылку подписки у провайдера и нажмите «Вставить». Подписок может быть сколько угодно."
                           FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Undo after removing a subscription -->
            <Border VerticalAlignment="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource AccentStroke}"
                    BorderThickness="1" CornerRadius="14" Padding="14,9,9,9" Margin="0,0,0,4"
                    Visibility="{Binding SubscriptionsVm.IsUndoVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button Style="{StaticResource TonalBtn}" Height="28" FontSize="11" Content="Вернуть"
                            DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Command="{Binding SubscriptionsVm.UndoCommand}"/>
                    <TextBlock Text="{Binding SubscriptionsVm.UndoMessage}" FontSize="11.5" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                </DockPanel>
            </Border>
        </Grid>

        <CheckBox Grid.Row="3" Style="{StaticResource SettingRow}" Margin="0"
                  Content="Автообновление"
                  Tag="Обновление всех подписок раз в сутки"
                  IsChecked="{Binding AutoUpdateSubscription}"/>
    </Grid>
</UserControl>
