<Window x:Class="Zion.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Zion.ViewModels"
        xmlns:views="clr-namespace:Zion.Views"
        xmlns:conv="clr-namespace:Zion.Views.Converters"
        xmlns:models="clr-namespace:Zion.Models"
        Title="Zion" Width="461" Height="696" MinHeight="696"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" Foreground="#F4F6FB"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanMinimize" FontFamily="Segoe UI Variable Text, Segoe UI, Inter, Arial"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        RenderOptions.BitmapScalingMode="HighQuality"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ================= Palette ================= -->
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F6FB"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A3ACC2"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7690"/>
        <SolidColorBrush x:Key="Glass" Color="#0CFFFFFF"/>
        <SolidColorBrush x:Key="GlassHover" Color="#17FFFFFF"/>
        <SolidColorBrush x:Key="Stroke" Color="#16FFFFFF"/>
        <SolidColorBrush x:Key="StrokeHover" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#8B7DFF"/>
        <SolidColorBrush x:Key="AccentHi" Color="#B3A9FF"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#268B7DFF"/>
        <SolidColorBrush x:Key="AccentStroke" Color="#668B7DFF"/>
        <SolidColorBrush x:Key="Success" Color="#34E0A1"/>
        <SolidColorBrush x:Key="Danger" Color="#FB7185"/>
        <SolidColorBrush x:Key="Surface" Color="#151824"/>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9D8FFF" Offset="0"/>
            <GradientStop Color="#6A5AF9" Offset="1"/>
        </LinearGradientBrush>

        <!-- ================= Text ================= -->
        <Style x:Key="Overline" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="2,0,0,5"/>
        </Style>

        <!-- Screen enter animation: fade + rise -->
        <Style x:Key="ScreenHost" TargetType="Grid">
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="10" To="0" Duration="0:0:0.28">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ================= Tray menu ================= -->
        <ContextMenu x:Key="TrayContextMenu">
            <ContextMenu.Template>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#151824" BorderBrush="#2A2F42" BorderThickness="1" CornerRadius="12" Padding="6" SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </ContextMenu.Template>
            <ContextMenu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#D5DAE8"/>
                    <Setter Property="FontSize" Value="12.5"/>
                    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Arial"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="14,8" Margin="0,1">
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#262B3D"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="Separator">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Separator">
                                <Border Height="1" Background="#262B3D" Margin="8,4"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="Открыть Zion" Click="TrayOpen_Click"/>
            <Separator/>
            <MenuItem Header="Подключить / Отключить" Click="TrayToggle_Click"/>
            <Separator/>
            <MenuItem Header="Выход" Click="TrayExit_Click"/>
        </ContextMenu>

        <!-- ================= Lists & scrolling ================= -->
        <Style x:Key="ModernListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBd" Background="#2EFFFFFF" CornerRadius="2" Width="4"
                                HorizontalAlignment="Right" Margin="0,2,1,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="{StaticResource AccentHi}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Width="7">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Inputs ================= -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Glass}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentHi}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Grid VerticalAlignment="Center">
                                <TextBlock x:Name="watermark" Text="{TemplateBinding Tag}" Foreground="{StaticResource TextMuted}" FontSize="12"
                                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis"/>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="bd" Property="Background" Value="#148B7DFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#D5DAE8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#262B3D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentHi}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton" Focusable="False" Cursor="Hand"
                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Border" Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}"
                                    BorderThickness="1" CornerRadius="10" Padding="11,0" Height="36">
                                <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                    <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource AccentHi}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="12,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#F4F6FB"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>
                <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Grid Name="DropDown" MinWidth="{TemplateBinding ActualWidth}"
                          MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                        <Border x:Name="DropDownBorder" Background="{StaticResource Surface}" BorderBrush="#2A2F42"
                                BorderThickness="1" CornerRadius="12" Margin="0,4,0,0" Padding="4">
                            <ScrollViewer SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource DarkComboBoxTemplate}"/>
            <Setter Property="Foreground" Value="#F4F6FB"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <!-- ================= Buttons ================= -->
        <!-- Title-bar buttons: the icon is a Path in Content, coloured by Foreground -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource GlassHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinBtnClose" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5484D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Square glass icon button (back, refresh) -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource GlassHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same as IconBtn, but turns red on hover: for destructive actions -->
        <Style x:Key="IconBtnDanger" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1FFB7185"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#59FB7185"/>
                                <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Solid red button: the confirming step of a destructive action -->
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="#E5566B" CornerRadius="12"/>
                            <Border x:Name="sheen" Background="#FFFFFF" CornerRadius="12" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="sheen" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="sheen" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Large glass card that acts as a button -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource GlassHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{StaticResource AccentGradient}" CornerRadius="12"/>
                            <Border x:Name="sheen" Background="#FFFFFF" CornerRadius="12" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="sheen" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="sheen" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource GlassHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tinted accent button (paste / copy / undo) -->
        <Style x:Key="TonalBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource AccentHi}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentStroke}"
                                BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#408B7DFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick-setting tile: label + animated switch -->
        <Style x:Key="QuickToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="tile" Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="12" Padding="11,0" Height="38">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                <Grid Grid.Column="1" Width="30" Height="18" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Border CornerRadius="9" Background="#24FFFFFF"/>
                                    <Border x:Name="trackOn" CornerRadius="9" Background="{StaticResource AccentGradient}" Opacity="0"/>
                                    <Ellipse x:Name="thumb" Width="12" Height="12" Fill="#C9CFDD" HorizontalAlignment="Left" Margin="3,0,0,0">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="thumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource AccentStroke}"/>
                                <Setter TargetName="tile" Property="Background" Value="#148B7DFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="12" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="trackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="trackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full-width settings row: title (Content) + explanation (Tag) + animated switch -->
        <Style x:Key="SettingRow" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="tile" Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="16" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                    <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="11" FontWeight="Normal" Foreground="{StaticResource TextMuted}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Grid Grid.Column="1" Width="36" Height="20" VerticalAlignment="Center">
                                    <Border CornerRadius="10" Background="#24FFFFFF"/>
                                    <Border x:Name="trackOn" CornerRadius="10" Background="{StaticResource AccentGradient}" Opacity="0"/>
                                    <Ellipse x:Name="thumb" Width="14" Height="14" Fill="#C9CFDD" HorizontalAlignment="Left" Margin="3,0,0,0">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="thumb" Property="Fill" Value="#FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="16" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="trackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="trackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tile" Property="Background" Value="{StaticResource GlassHover}"/>
                                <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small rounded label -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Row action inside a server card (edit / delete) -->
        <Style x:Key="RowAction" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource GlassHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 18px transparent gutter around the window holds the soft shadow -->
    <Grid Margin="18">
        <Border CornerRadius="24" Background="#090A11">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.55"/>
            </Border.Effect>
        </Border>

        <Grid>
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,425,660" RadiusX="24" RadiusY="24"/>
            </Grid.Clip>

            <!-- Backdrop: deep gradient with a faint cool tint in the lower-left corner -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                        <GradientStop Color="#10111B" Offset="0"/>
                        <GradientStop Color="#08090F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Rectangle Width="460" Height="460" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-230,0,0,-250"
                       Fill="#5B8CFF" Opacity="0.24" IsHitTestVisible="False">
                <Rectangle.OpacityMask>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF000000" Offset="0"/>
                        <GradientStop Color="#66000000" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>

            <!-- ========================================================================= -->
            <!-- 1. DASHBOARD VIEW -->
            <!-- ========================================================================= -->
            <Grid x:Name="DashboardView" Style="{StaticResource ScreenHost}"
                  Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVis}}"
                  Margin="20,16,20,18">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Notification (server switched, Kill Switch problems). Takes the place of the session
                     timer while it is shown; click to dismiss. -->
                <Button Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Top" Margin="0,50,0,0" MinHeight="58"
                        Panel.ZIndex="10" Cursor="Hand" Focusable="False"
                        Command="{Binding DismissToastCommand}"
                        Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource AccentStroke}" BorderThickness="1"
                                    CornerRadius="16" Padding="14,11">
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" Data="M 0 0 L 8 8 M 8 0 L 0 8" Stroke="{StaticResource TextMuted}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="10,0,2,0"/>
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentHi}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding ToastText}" FontSize="12" Foreground="{StaticResource TextPrimary}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Top bar: wordmark + window controls -->
                <DockPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Wordmark glows in the same colour as the power button: a blurred copy sits under the crisp text -->
                        <Grid VerticalAlignment="Center" Margin="2,0,0,0">
                            <TextBlock Text="Zion" FontSize="19" FontWeight="Bold" Foreground="{Binding StatusDotColor}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" Opacity="0.9" IsHitTestVisible="False">
                                <TextBlock.Effect>
                                    <BlurEffect Radius="14"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="Zion" FontSize="19" FontWeight="Bold" Foreground="{Binding PowerBtnRingStroke}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource WinBtn}" Command="{Binding NavigateToSettingsCommand}" Margin="0,0,2,0" ToolTip="Настройки">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                        </Button>
                        <Button Style="{StaticResource WinBtn}" Click="BtnMinimize_Click" Margin="0,0,2,0" ToolTip="Свернуть">
                            <Path Data="M 0 0 H 10" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Style="{StaticResource WinBtnClose}" Click="BtnClose_Click" ToolTip="Скрыть в трей">
                            <Path Data="M 0 0 L 9 9 M 9 0 L 0 9" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Hero: session timer, traffic, power button, prompt -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,6">
                    <!-- Steps aside while a notification is shown in its place (keeps its space, so nothing jumps) -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                                        <Setter Property="Opacity" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding SessionTimerText}" FontSize="44" FontWeight="Light"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" Typography.NumeralAlignment="Tabular"
                                   Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="Трафик за сессию  ·  " FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding TotalTrafficText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Width="172" Height="172" HorizontalAlignment="Center" VerticalAlignment="Center"
                          SnapsToDevicePixels="False" UseLayoutRounding="False">
                        <!-- Breathing outer ring -->
                        <Grid x:Name="HaloContainer" Width="160" Height="160"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5"
                              SnapsToDevicePixels="False" UseLayoutRounding="False">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="HaloScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Grid.RenderTransform>
                            <Border Width="160" Height="160" CornerRadius="80" Opacity="0.55"
                                    Background="{Binding OuterHaloBg}"
                                    SnapsToDevicePixels="False" UseLayoutRounding="False"/>
                            <Border x:Name="OuterHaloGlowBorder" Width="160" Height="160" CornerRadius="80"
                                    BorderBrush="{Binding OuterHaloBorder}"
                                    BorderThickness="1.5" Opacity="0.35"
                                    SnapsToDevicePixels="False" UseLayoutRounding="False"/>
                        </Grid>
                        <Border Width="142" Height="142" CornerRadius="71" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                IsHitTestVisible="False" SnapsToDevicePixels="False" UseLayoutRounding="False"/>

                        <!-- Power button -->
                        <Button Width="124" Height="124" Cursor="Hand" Focusable="False"
                                Command="{Binding ToggleConnectionCommand}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                SnapsToDevicePixels="False" UseLayoutRounding="False"
                                RenderTransformOrigin="0.5,0.5">
                            <Button.RenderTransform>
                                <ScaleTransform x:Name="BtnBreathingScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Button.RenderTransform>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="btnGrid" RenderTransformOrigin="0.5,0.5"
                                          SnapsToDevicePixels="False" UseLayoutRounding="False">
                                        <Grid.RenderTransform>
                                            <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                        </Grid.RenderTransform>
                                        <Border CornerRadius="62"
                                                BorderBrush="{Binding Path=DataContext.PowerBtnRingStroke, RelativeSource={RelativeSource AncestorType=Window}}"
                                                BorderThickness="1.5"
                                                Background="{Binding Path=DataContext.PowerBtnBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                SnapsToDevicePixels="False" UseLayoutRounding="False"/>
                                        <Grid Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M 13.5 8 A 15 15 0 1 0 28.5 8"
                                                  Stroke="#FFFFFF" StrokeThickness="3.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                            <Line X1="21" Y1="2" X2="21" Y2="15"
                                                  Stroke="#FFFFFF" StrokeThickness="3.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnGrid" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.035" ScaleY="1.035"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="btnGrid" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.955" ScaleY="0.955"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="Grid.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="60">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HaloScale"
                                                                       Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.07" KeySpline="0.4,0.0 0.2,1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HaloScale"
                                                                       Storyboard.TargetProperty="ScaleY" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.07" KeySpline="0.4,0.0 0.2,1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OuterHaloGlowBorder"
                                                                       Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.9" KeySpline="0.4,0.0 0.2,1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BtnBreathingScale"
                                                                       Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.02" KeySpline="0.4,0.0 0.2,1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BtnBreathingScale"
                                                                       Storyboard.TargetProperty="ScaleY" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.02" KeySpline="0.4,0.0 0.2,1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                    </Grid>

                    <TextBlock Text="{Binding PowerPromptText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{Binding PowerStatusTextColor}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Bottom cards -->
                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                    <!-- Server -->
                    <Button Style="{StaticResource CardButton}" Margin="0,0,0,8"
                            Command="{Binding OpenServerListCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource GlassHover}" Margin="0,0,12,0">
                                <views:FlagBadge Country="{Binding ServerCardCountry}" Width="24" Height="16"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="СЕРВЕР" Style="{StaticResource Overline}"/>
                                <TextBlock Text="{Binding ServerCardSubtitle}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Pill}">
                                    <TextBlock Text="{Binding ServerCardBadge}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentHi}"/>
                                </Border>
                                <Path Data="M 0 0 L 4.5 4.5 L 0 9" Stroke="{StaticResource TextMuted}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="10,0,2,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- DNS -->
                    <Button Style="{StaticResource CardButton}" Margin="0,0,0,8"
                            Command="{Binding OpenDnsModalCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource GlassHover}" Margin="0,0,12,0">
                                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource AccentHi}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 M 2 12 H 22 M 12 2 C 8 6 8 18 12 22 M 12 2 C 16 6 16 18 12 22"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="DNS" Style="{StaticResource Overline}"/>
                                <TextBlock Text="{Binding DnsSubtitleText}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{Binding DnsSubtitleColor}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Pill}">
                                    <TextBlock Text="{Binding DnsBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentHi}"/>
                                </Border>
                                <Path Data="M 0 0 L 4.5 4.5 L 0 9" Stroke="{StaticResource TextMuted}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="10,0,2,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Live speed -->
                    <Border CornerRadius="16" Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            Padding="14,9" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="9" Background="#1F34E0A1" Margin="0,0,10,0">
                                    <Path Data="M 5 0 V 10 M 0.5 5.5 L 5 10 L 9.5 5.5" Stroke="{StaticResource Success}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ЗАГРУЗКА" Style="{StaticResource Overline}" FontSize="9"/>
                                    <TextBlock Text="{Binding DownSpeedText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Background="{StaticResource Stroke}" Margin="10,2"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                <Border Width="26" Height="26" CornerRadius="9" Background="{StaticResource AccentSoft}" Margin="0,0,10,0">
                                    <Path Data="M 5 10 V 0 M 0.5 4.5 L 5 0 L 9.5 4.5" Stroke="{StaticResource AccentHi}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ОТДАЧА" Style="{StaticResource Overline}" FontSize="9"/>
                                    <TextBlock Text="{Binding UpSpeedText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Quick settings -->
                    <UniformGrid Columns="2">
                        <CheckBox Style="{StaticResource QuickToggle}"
                                  Content="Автоподключение"
                                  IsChecked="{Binding AutoConnectOnStartup}"
                                  Margin="0,0,4,8"
                                  ToolTip="Автоматически поднимать туннель при запуске приложения"/>
                        <CheckBox Style="{StaticResource QuickToggle}"
                                  Content="Обход РФ"
                                  IsChecked="{Binding BypassDomesticRu}"
                                  Margin="4,0,0,8"
                                  ToolTip="Прямое подключение к РУ сайтам"/>
                        <CheckBox Style="{StaticResource QuickToggle}"
                                  Content="Обход торрентов"
                                  IsChecked="{Binding BypassTorrents}"
                                  Margin="0,0,4,0"
                                  ToolTip="Скачивание торрентов напрямую без VPN"/>
                        <CheckBox Style="{StaticResource QuickToggle}"
                                  Content="Kill Switch"
                                  IsChecked="{Binding KillSwitch}"
                                  Margin="4,0,0,0"
                                  ToolTip="Блокировка трафика при аварийном разрыве VPN"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 2. SERVER LIST VIEW -->
            <!-- ========================================================================= -->
            <Grid x:Name="ServerListView" Style="{StaticResource ScreenHost}"
                  Visibility="{Binding IsServerListVisible, Converter={StaticResource BoolToVis}}"
                  Margin="18,16,18,18">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconBtn}" Click="BtnBackToDashboard_Click" Margin="0,0,12,0" ToolTip="Назад на главный экран">
                            <Path Data="M 5 0 L 0 5 L 5 10" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <TextBlock Text="Серверы" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <Border Style="{StaticResource Pill}" Margin="9,1,0,0">
                            <TextBlock Text="{Binding ServerListVm.ServerCount}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentHi}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconBtnDanger}" ToolTip="Удалить все серверы" Margin="0,0,6,0"
                                Command="{Binding ServerListVm.AskDeleteAllCommand}">
                            <Path Width="13" Height="14" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" ToolTip="Подписки" Margin="0,0,6,0"
                                Command="{Binding OpenSubscriptionsCommand}">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" ToolTip="Обновить все подписки" Margin="0,0,8,0"
                                Command="{Binding ServerListVm.RefreshSubscriptionCommand}">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                        </Button>
                        <Button Style="{StaticResource WinBtn}" Click="BtnMinimize_Click" Margin="0,0,2,0" ToolTip="Свернуть">
                            <Path Data="M 0 0 H 10" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Style="{StaticResource WinBtnClose}" Click="BtnClose_Click" ToolTip="Скрыть в трей">
                            <Path Data="M 0 0 L 9 9 M 9 0 L 0 9" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <ListBox ItemsSource="{Binding ServerListVm.ListItems}"
                             ItemContainerStyle="{StaticResource ModernListBoxItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             Background="Transparent" BorderThickness="0"
                             Padding="0,0,4,0">
                        <ListBox.Resources>
                            <!-- Section title: favourites, a subscription, manual servers -->
                            <DataTemplate DataType="{x:Type vm:ServerGroupHeader}">
                                <DockPanel x:Name="HeaderRow" Margin="4,10,6,0" Cursor="Arrow" Background="Transparent">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource Overline}"/>
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Overline}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                        <Setter TargetName="HeaderRow" Property="Margin" Value="4,2,6,0"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>

                            <!-- A provider's own divider ("Белые списки ниже") -->
                            <DataTemplate DataType="{x:Type vm:ServerSubHeader}">
                                <DockPanel Margin="4,4,6,0" Cursor="Arrow" Background="Transparent">
                                    <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <Border Height="1" Background="{StaticResource Stroke}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type models:ProxyItem}">
                                <Border x:Name="CardBorder" CornerRadius="16" Background="{StaticResource Glass}"
                                        BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                        Padding="12,10,8,10" MouseLeftButtonUp="Card_MouseLeftButtonUp">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="FlagTile" Width="38" Height="38" CornerRadius="12" Background="{StaticResource GlassHover}" Margin="0,0,12,0">
                                            <views:FlagBadge Country="{Binding Country}" Width="24" Height="16"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding CleanName}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DisplayAddress}" FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource Pill}" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding ProtocolBadge}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentHi}"/>
                                            </Border>

                                            <!-- Favourite: outline star, filled amber when marked -->
                                            <Border MouseLeftButtonUp="BtnFavorite_MouseLeftButtonUp">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource RowAction}">
                                                        <Setter Property="ToolTip" Value="В избранное"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="ToolTip" Value="Убрать из избранного"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.6" StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.52l-5.88 3.09 1.12-6.55L2.48 9.42l6.58-.96z">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Stroke" Value="{StaticResource TextMuted}"/>
                                                            <Setter Property="Fill" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="Stroke" Value="#FBBF24"/>
                                                                    <Setter Property="Fill" Value="#FBBF24"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Border>

                                            <Border Style="{StaticResource RowAction}" ToolTip="Редактировать"
                                                    MouseLeftButtonUp="BtnEditServer_MouseLeftButtonUp">
                                                <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                                      Fill="{StaticResource TextSecondary}" Width="11" Height="11" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <Border Style="{StaticResource RowAction}" ToolTip="Удалить"
                                                    MouseLeftButtonUp="BtnDeleteServer_MouseLeftButtonUp">
                                                <Path Data="M 0 0 L 8 8 M 8 0 L 0 8" Stroke="{StaticResource Danger}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource GlassHover}"/>
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="CardBorder" Property="Background" Value="#1F8B7DFF"/>
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                        <Setter TargetName="FlagTile" Property="Background" Value="#338B7DFF"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>

                    <!-- Empty list -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,40" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Proxies.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Список пуст" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Добавьте сервер или ссылку на подписку кнопкой ниже." FontSize="11.5" Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Undo snackbar -->
                    <Border VerticalAlignment="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource AccentStroke}"
                            BorderThickness="1" CornerRadius="14" Padding="14,9,9,9" Margin="0,0,0,4"
                            Visibility="{Binding ServerListVm.IsUndoVisible, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button Style="{StaticResource TonalBtn}" Height="28" FontSize="11" Content="Отменить"
                                    DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Command="{Binding ServerListVm.UndoDeleteCommand}"/>
                            <TextBlock Text="{Binding ServerListVm.UndoMessage}" FontSize="11.5" Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <Button Grid.Row="2" Style="{StaticResource PrimaryBtn}" Height="42" Click="BtnOpenAddServer_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 5 0 V 10 M 0 5 H 10" Stroke="#FFFFFF" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Text="Добавить сервер" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 3. SERVER EDIT VIEW -->
            <!-- ========================================================================= -->
            <Grid x:Name="ServerEditView" Style="{StaticResource ScreenHost}"
                  Visibility="{Binding IsServerEditVisible, Converter={StaticResource BoolToVis}}"
                  Margin="18,16,18,18">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconBtn}" Click="BtnBackToServerList_Click" Margin="0,0,12,0" ToolTip="Назад к списку">
                            <Path Data="M 5 0 L 0 5 L 5 10" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <TextBlock Text="{Binding EditFormTitle}" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"
                                   TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource WinBtn}" Click="BtnMinimize_Click" Margin="0,0,2,0" ToolTip="Свернуть">
                            <Path Data="M 0 0 H 10" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Style="{StaticResource WinBtnClose}" Click="BtnClose_Click" ToolTip="Скрыть в трей">
                            <Path Data="M 0 0 L 9 9 M 9 0 L 0 9" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Quick import / export -->
                <Border Grid.Row="1" Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                        CornerRadius="16" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,2">
                            <TextBlock x:Name="EditCopyToastText" Text="✓ Скопировано" Foreground="{StaticResource Success}" FontWeight="SemiBold" FontSize="11"
                                       DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock Text="Ссылка сервера" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="12.5"/>
                        </DockPanel>
                        <TextBlock Text="Вставьте готовую ссылку или скопируйте текущую" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,9"/>
                        <TextBox x:Name="EditQuickInputTextBox" Tag="vless://, trojan://, ss://, vmess://, hysteria2://, tuic://, подписка https://..."
                                 TextChanged="EditQuickInputTextBox_TextChanged" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource TonalBtn}" Height="32" Content="Вставить" Click="EditPasteFromClipboard_Click"/>
                            <Button Grid.Column="2" Style="{StaticResource GhostBtn}" Height="32" FontSize="12" Content="Скопировать" Click="EditCopyLink_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="Название" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="EditNameTextBox" Tag="например: Германия #1 или США" TextChanged="OnEditFormFieldChanged" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.8*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Хост / IP" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="EditHostTextBox" Tag="vpn.example.com" TextChanged="EditHostTextBox_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Порт" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="EditPortTextBox" Tag="443" TextChanged="OnEditFormFieldChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Протокол" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="EditProtocolComboBox" SelectionChanged="EditProtocolComboBox_SelectionChanged">
                                    <ComboBoxItem Content="VLESS" IsSelected="True"/>
                                    <ComboBoxItem Content="Trojan"/>
                                    <ComboBoxItem Content="Shadowsocks"/>
                                    <ComboBoxItem Content="VMess"/>
                                    <ComboBoxItem Content="Hysteria2"/>
                                    <ComboBoxItem Content="TUIC"/>
                                    <ComboBoxItem Content="SOCKS5"/>
                                    <ComboBoxItem Content="HTTP"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="EditVlessPanel">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Ключ пользователя (UUID)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="EditUuidTextBox" Tag="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" TextChanged="OnEditFormFieldChanged"/>
                            </StackPanel>

                            <Border Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                    CornerRadius="16" Padding="12,12,12,4" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="СЕТЬ И МАСКИРОВКА" Style="{StaticResource Overline}" Foreground="{StaticResource AccentHi}" Margin="2,0,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Транспорт" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="EditTransportComboBox" SelectionChanged="OnEditFormFieldChanged">
                                                <ComboBoxItem Content="TCP" IsSelected="True"/>
                                                <ComboBoxItem Content="gRPC"/>
                                                <ComboBoxItem Content="WebSocket (WS)"/>
                                                <ComboBoxItem Content="HTTPUpgrade"/>
                                                <ComboBoxItem Content="H2"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="Безопасность" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="EditSecurityComboBox" SelectionChanged="OnEditFormFieldChanged">
                                                <ComboBoxItem Content="Reality" IsSelected="True"/>
                                                <ComboBoxItem Content="TLS"/>
                                                <ComboBoxItem Content="None"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Отпечаток (FP)" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="EditFingerprintComboBox" SelectionChanged="OnEditFormFieldChanged">
                                                <ComboBoxItem Content="Chrome" IsSelected="True"/>
                                                <ComboBoxItem Content="Firefox"/>
                                                <ComboBoxItem Content="Safari"/>
                                                <ComboBoxItem Content="Edge"/>
                                                <ComboBoxItem Content="iOS"/>
                                                <ComboBoxItem Content="Random"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Сайт маскировки (SNI)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="EditSniTextBox" Tag="yahoo.com" TextChanged="OnEditFormFieldChanged"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Публичный ключ (PBK)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="EditPublicKeyTextBox" Tag="Public Key" TextChanged="OnEditFormFieldChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Короткий ID (ShortId)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="EditShortIdTextBox" Tag="Short ID" TextChanged="OnEditFormFieldChanged"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Служба / Путь" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="EditServiceOrPathTextBox" Tag="ServiceName / Path" TextChanged="OnEditFormFieldChanged"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="EditAuthPanel" Visibility="Collapsed">
                            <TextBlock Text="АВТОРИЗАЦИЯ (НЕОБЯЗАТЕЛЬНО)" Style="{StaticResource Overline}" Foreground="{StaticResource AccentHi}" Margin="2,2,0,10"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Логин" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EditUserTextBox" Tag="Логин" TextChanged="OnEditFormFieldChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EditPassTextBox" Tag="Пароль" TextChanged="OnEditFormFieldChanged"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Hysteria2 / TUIC -->
                        <StackPanel x:Name="EditQuicPanel" Visibility="Collapsed">
                            <UniformGrid Rows="1" Margin="0,0,0,10">
                                <StackPanel x:Name="EditTuicUuidPanel" Margin="0,0,8,0">
                                    <TextBlock Text="Ключ пользователя (UUID)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EditTuicUuidTextBox" Tag="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" TextChanged="OnEditFormFieldChanged"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EditQuicPasswordTextBox" Tag="Пароль" TextChanged="OnEditFormFieldChanged"/>
                                </StackPanel>
                            </UniformGrid>

                            <Border Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                    CornerRadius="16" Padding="12,12,12,4" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="СОЕДИНЕНИЕ" Style="{StaticResource Overline}" Foreground="{StaticResource AccentHi}" Margin="2,0,0,10"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Сайт маскировки (SNI)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="EditQuicSniTextBox" Tag="example.com" TextChanged="OnEditFormFieldChanged"/>
                                        </StackPanel>
                                        <StackPanel x:Name="EditObfsPanel" Grid.Column="1">
                                            <TextBlock Text="Пароль обфускации" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="EditObfsPasswordTextBox" Tag="Salamander" TextChanged="OnEditFormFieldChanged"/>
                                        </StackPanel>
                                        <StackPanel x:Name="EditCongestionPanel" Grid.Column="1" Visibility="Collapsed">
                                            <TextBlock Text="Контроль перегрузки" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="EditCongestionComboBox" SelectionChanged="OnEditFormFieldChanged">
                                                <ComboBoxItem Content="BBR" IsSelected="True"/>
                                                <ComboBoxItem Content="Cubic"/>
                                                <ComboBoxItem Content="New_Reno"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="EditHopPortsPanel" Margin="0,0,0,8">
                                        <TextBlock Text="Диапазон портов" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="EditHopPortsTextBox" Tag="20000-30000" TextChanged="OnEditFormFieldChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.6*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource GhostBtn}" Height="42" Content="Отмена" Click="BtnBackToServerList_Click"/>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryBtn}" Height="42" Content="Сохранить" Click="BtnSaveServer_Click"/>
                </Grid>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 4. SETTINGS VIEW -->
            <!-- ========================================================================= -->
            <Grid x:Name="SettingsView" Style="{StaticResource ScreenHost}"
                  Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}"
                  Margin="18,16,18,18">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconBtn}" Click="BtnBackToDashboard_Click" Margin="0,0,12,0" ToolTip="Назад на главный экран">
                            <Path Data="M 5 0 L 0 5 L 5 10" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <TextBlock Text="Настройки" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource WinBtn}" Click="BtnMinimize_Click" Margin="0,0,2,0" ToolTip="Свернуть">
                            <Path Data="M 0 0 H 10" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Style="{StaticResource WinBtnClose}" Click="BtnClose_Click" ToolTip="Скрыть в трей">
                            <Path Data="M 0 0 L 9 9 M 9 0 L 0 9" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="ПОДКЛЮЧЕНИЕ" Style="{StaticResource Overline}" Margin="4,2,0,8"/>
                        <CheckBox Style="{StaticResource SettingRow}"
                                  Content="Автопереключение сервера"
                                  Tag="Переход на другой сервер, если текущий недоступен"
                                  IsChecked="{Binding AutoServerFailover}"/>


                        <TextBlock Text="ИСКЛЮЧЕНИЯ" Style="{StaticResource Overline}" Margin="4,10,0,8"/>
                        <Button Style="{StaticResource CardButton}" Command="{Binding OpenExclusionsCommand}" Margin="0,0,0,8" Padding="14,12">
                            <DockPanel>
                                <Path DockPanel.Dock="Right" Data="M 0 0 L 5 5 L 0 10" Stroke="{StaticResource TextMuted}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Программы мимо VPN" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding ExcludedAppsVm.Summary}" FontSize="11" Foreground="{StaticResource TextMuted}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource CardButton}" Command="{Binding OpenExcludedSitesCommand}" Margin="0,0,0,8" Padding="14,12">
                            <DockPanel>
                                <Path DockPanel.Dock="Right" Data="M 0 0 L 5 5 L 0 10" Stroke="{StaticResource TextMuted}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Сайты мимо VPN" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding ExcludedSitesVm.Summary}" FontSize="11" Foreground="{StaticResource TextMuted}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <TextBlock Text="ЗАЩИТА" Style="{StaticResource Overline}" Margin="4,10,0,8"/>
                        <CheckBox Style="{StaticResource SettingRow}"
                                  Content="Блокировать WebRTC"
                                  Tag="Запрет STUN-запросов браузера"
                                  IsChecked="{Binding BlockWebRtc}"/>
                        <CheckBox Style="{StaticResource SettingRow}"
                                  Content="Блокировать QUIC"
                                  Tag="Сайты работают через HTTPS вместо QUIC"
                                  IsChecked="{Binding BlockQuic}"/>
                        <CheckBox Style="{StaticResource SettingRow}"
                                  Content="Блокировать трекеры"
                                  Tag="Блокировка аналитики и рекламных сетей"
                                  IsChecked="{Binding BlockTrackers}"/>


                        <TextBlock Text="ДИАГНОСТИКА" Style="{StaticResource Overline}" Margin="4,18,0,8"/>
                        <Border Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                CornerRadius="16" Padding="14,12">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource TonalBtn}" Height="32" FontSize="11.5"
                                        MinWidth="104" VerticalAlignment="Center" Margin="14,0,0,0"
                                        Content="{Binding CopyLogsButtonText}" Command="{Binding CopyLogsCommand}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Журнал событий" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Подключения, ошибки и смены серверов"
                                               FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 4b. SUBSCRIPTIONS VIEW (any number of links) -->
            <!-- ========================================================================= -->
            <Grid x:Name="SubscriptionsView" Style="{StaticResource ScreenHost}"
                  Visibility="{Binding IsSubscriptionsVisible, Converter={StaticResource BoolToVis}}"
                  Margin="18,16,18,18">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconBtn}" Command="{Binding SubscriptionsVm.BackCommand}" Margin="0,0,12,0" ToolTip="Назад к серверам">
                            <Path Data="M 5 0 L 0 5 L 5 10" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <TextBlock Text="Подписки" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <Border Style="{StaticResource Pill}" Margin="9,1,0,0">
                            <TextBlock Text="{Binding SubscriptionsVm.Count}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentHi}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconBtn}" ToolTip="Обновить все подписки" Margin="0,0,8,0"
                                Command="{Binding SubscriptionsVm.RefreshAllCommand}">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                        </Button>
                        <Button Style="{StaticResource WinBtn}" Click="BtnMinimize_Click" Margin="0,0,2,0" ToolTip="Свернуть">
                            <Path Data="M 0 0 H 10" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Style="{StaticResource WinBtnClose}" Click="BtnClose_Click" ToolTip="Скрыть в трей">
                            <Path Data="M 0 0 L 9 9 M 9 0 L 0 9" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Add a link -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Height="40" Tag="Ссылка на подписку: https://…"
                                 Text="{Binding SubscriptionsVm.NewUrl, UpdateSourceTrigger=PropertyChanged}"/>
                        <!-- Empty field: one click pastes from the clipboard; with text: adds it -->
                        <Button Grid.Column="1" Height="40" MinWidth="104" Margin="8,0,0,0" Padding="14,0"
                                Command="{Binding SubscriptionsVm.AddCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
                                    <Setter Property="Content" Value="Добавить"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SubscriptionsVm.HasNewUrl}" Value="False">
                                            <Setter Property="Content" Value="Вставить"/>
                                            <Setter Property="ToolTip" Value="Вставить ссылку из буфера обмена и добавить"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SubscriptionsVm.IsAdding}" Value="True">
                                            <Setter Property="Content" Value="Загрузка…"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding SubscriptionsVm.Status}" FontSize="11.5" TextWrapping="Wrap" Margin="4,8,0,0"
                               Visibility="{Binding SubscriptionsVm.HasStatus, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SubscriptionsVm.StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- The list -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SubscriptionsVm.Rows}" Margin="0,0,4,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                            CornerRadius="16" Padding="14,12,10,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Host}" FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <StackPanel Margin="0,9,0,0" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                                                    <Grid Height="4" Margin="0,0,0,6" Visibility="{Binding HasQuota, Converter={StaticResource BoolToVis}}">
                                                        <Border CornerRadius="2" Background="#1FFFFFFF"/>
                                                        <Border CornerRadius="2" RenderTransformOrigin="0,0.5">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="{Binding UsedFraction}"/>
                                                            </Border.RenderTransform>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PlanWarning}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource Danger}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding PlanText}" FontSize="11" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PlanWarning}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FBBF24"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Style="{StaticResource IconBtn}" Width="30" Height="30" Margin="0,0,6,0"
                                                        ToolTip="Обновить" Command="{Binding RefreshCommand}">
                                                    <Path Width="12" Height="12" Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                                                </Button>
                                                <!-- Delete: first click arms it (turns into a red "Удалить?"), the second removes -->
                                                <Button Width="30" Height="30" ToolTip="Удалить подписку" Command="{Binding DeleteCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource IconBtnDanger}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDeleteArmed}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Path Width="11" Height="12" Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                                </Button>
                                                <Button Style="{StaticResource DangerBtn}" Height="30" FontSize="11.5" Padding="12,0" MinWidth="84"
                                                        Content="Удалить?" ToolTip="Нажмите ещё раз, чтобы удалить подписку и её серверы"
                                                        Command="{Binding DeleteCommand}"
                                                        Visibility="{Binding IsDeleteArmed, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- No subscriptions yet -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,40" IsHitTestVisible="False"
                                Visibility="{Binding SubscriptionsVm.IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Подписок пока нет" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Скопируйте ссылку подписки у провайдера и нажмите «Вставить». Подписок может быть сколько угодно."
                                   FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Undo after removing a subscription -->
                    <Border VerticalAlignment="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource AccentStroke}"
                            BorderThickness="1" CornerRadius="14" Padding="14,9,9,9" Margin="0,0,0,4"
                            Visibility="{Binding SubscriptionsVm.IsUndoVisible, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button Style="{StaticResource TonalBtn}" Height="28" FontSize="11" Content="Вернуть"
                                    DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Command="{Binding SubscriptionsVm.UndoCommand}"/>
                            <TextBlock Text="{Binding SubscriptionsVm.UndoMessage}" FontSize="11.5" Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <CheckBox Grid.Row="3" Style="{StaticResource SettingRow}" Margin="0"
                          Content="Автообновление"
                          Tag="Обновление всех подписок раз в сутки"
                          IsChecked="{Binding AutoUpdateSubscription}"/>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 4c. PROGRAMS THAT BYPASS THE VPN -->
            <!-- ========================================================================= -->
            <Grid x:Name="ExclusionsView" Style="{StaticResource ScreenHost}"
                  Visibility="{Binding IsExclusionsVisible, Converter={StaticResource BoolToVis}}"
                  Margin="18,16,18,18">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconBtn}" Command="{Binding ExcludedAppsVm.BackCommand}" Margin="0,0,12,0" ToolTip="Назад к настройкам">
                            <Path Data="M 5 0 L 0 5 L 5 10" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <TextBlock Text="Мимо VPN" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <Border Style="{StaticResource Pill}" Margin="9,1,0,0">
                            <TextBlock Text="{Binding ExcludedAppsVm.Count}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentHi}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource WinBtn}" Click="BtnMinimize_Click" Margin="0,0,2,0" ToolTip="Свернуть">
                            <Path Data="M 0 0 H 10" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Style="{StaticResource WinBtnClose}" Click="BtnClose_Click" ToolTip="Скрыть в трей">
                            <Path Data="M 0 0 L 9 9 M 9 0 L 0 9" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <StackPanel Grid.Row="1" Margin="4,0,4,12">
                    <TextBlock Text="{Binding ExcludedAppsVm.Status}" FontSize="11.5" Foreground="{StaticResource AccentHi}" TextWrapping="Wrap"
                               Visibility="{Binding ExcludedAppsVm.HasStatus, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ExcludedAppsVm.Rows}" Margin="0,0,4,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                            CornerRadius="14" Padding="12,10,8,10" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource RowAction}" ToolTip="Вернуть в VPN"
                                                    VerticalAlignment="Center">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding RemoveCommand}"/>
                                                </Border.InputBindings>
                                                <Path Data="M 0 0 L 8 8 M 8 0 L 0 8" Stroke="{StaticResource Danger}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GlassHover}" Margin="0,0,12,0">
                                                <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ProcessName}" FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,30" IsHitTestVisible="False"
                                Visibility="{Binding ExcludedAppsVm.IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Пока все программы идут через VPN" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="Нажмите «Добавить программу» и выберите её из запущенных или найдите exe-файл."
                                   FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <Button Grid.Row="3" Style="{StaticResource PrimaryBtn}" Height="42" Command="{Binding ExcludedAppsVm.OpenPickerCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 5 0 V 10 M 0 5 H 10" Stroke="#FFFFFF" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Text="Добавить программу" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 4d. SITES THAT BYPASS THE VPN -->
            <!-- ========================================================================= -->
            <Grid x:Name="ExcludedSitesView" Style="{StaticResource ScreenHost}"
                  Visibility="{Binding IsExcludedSitesVisible, Converter={StaticResource BoolToVis}}"
                  Margin="18,16,18,18">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconBtn}" Command="{Binding ExcludedSitesVm.BackCommand}" Margin="0,0,12,0" ToolTip="Назад к настройкам">
                            <Path Data="M 5 0 L 0 5 L 5 10" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <TextBlock Text="Сайты мимо VPN" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <Border Style="{StaticResource Pill}" Margin="9,1,0,0">
                            <TextBlock Text="{Binding ExcludedSitesVm.Count}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentHi}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource WinBtn}" Click="BtnMinimize_Click" Margin="0,0,2,0" ToolTip="Свернуть">
                            <Path Data="M 0 0 H 10" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Style="{StaticResource WinBtnClose}" Click="BtnClose_Click" ToolTip="Скрыть в трей">
                            <Path Data="M 0 0 L 9 9 M 9 0 L 0 9" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Add a site -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Height="40" Tag="Адрес сайта, например kinopoisk.ru"
                                 Text="{Binding ExcludedSitesVm.NewSite, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ExcludedSitesVm.AddCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <!-- Empty field: one click takes the address from the clipboard -->
                        <Button Grid.Column="1" Height="40" MinWidth="104" Margin="8,0,0,0" Padding="14,0"
                                Command="{Binding ExcludedSitesVm.AddCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
                                    <Setter Property="Content" Value="Добавить"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExcludedSitesVm.HasNewSite}" Value="False">
                                            <Setter Property="Content" Value="Вставить"/>
                                            <Setter Property="ToolTip" Value="Вставить адрес из буфера обмена и добавить"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding ExcludedSitesVm.Status}" FontSize="11.5" TextWrapping="Wrap" Margin="4,8,0,0"
                               Visibility="{Binding ExcludedSitesVm.HasStatus, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource AccentHi}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExcludedSitesVm.StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ExcludedSitesVm.Rows}" Margin="0,0,4,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Glass}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                            CornerRadius="14" Padding="12,10,8,10" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource RowAction}" ToolTip="Вернуть в VPN" VerticalAlignment="Center">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding RemoveCommand}"/>
                                                </Border.InputBindings>
                                                <Path Data="M 0 0 L 8 8 M 8 0 L 0 8" Stroke="{StaticResource Danger}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GlassHover}" Margin="0,0,12,0">
                                                <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource AccentHi}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm6.93 6h-2.95c-.32-1.25-.78-2.45-1.38-3.56 1.84.63 3.37 1.91 4.33 3.56zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2 0 .68.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56-1.84-.63-3.37-1.9-4.33-3.56zm2.95-8H5.08c.96-1.66 2.49-2.93 4.33-3.56C8.81 5.55 8.35 6.75 8.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.09-.66-.16-1.32-.16-2 0-.68.07-1.35.16-2h4.68c.09.65.16 1.32.16 2 0 .68-.07 1.34-.16 2zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95c-.96 1.65-2.49 2.93-4.33 3.56zM16.36 14c.08-.66.14-1.32.14-2 0-.68-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z"/>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,40" IsHitTestVisible="False"
                                Visibility="{Binding ExcludedSitesVm.IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Пока все сайты идут через VPN" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="Поддомены добавляются автоматически." FontSize="11.5" Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 5. DNS MODAL OVERLAY (bottom sheet) -->
            <!-- ========================================================================= -->
            <Grid x:Name="DnsModalOverlay"
                  Visibility="{Binding IsDnsModalOpen, Converter={StaticResource BoolToVis}}"
                  Background="#B8050609"
                  MouseDown="DnsOverlay_MouseDown"
                  Panel.ZIndex="100">
                <Border x:Name="DnsModalCard" VerticalAlignment="Bottom" Margin="10,0,10,10"
                        Background="{StaticResource Surface}" BorderBrush="#2A2F42" BorderThickness="1" CornerRadius="22"
                        Padding="14,10,14,14" MouseDown="DnsModalCard_MouseDown">
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDnsModalOpen}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="60" To="0" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Border Width="38" Height="4" CornerRadius="2" Background="#33FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                        <DockPanel Margin="4,0,0,12">
                            <Button Style="{StaticResource WinBtn}" Width="28" Height="28" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Command="{Binding CloseDnsModalCommand}" ToolTip="Закрыть">
                                <Path Data="M 0 0 L 8 8 M 8 0 L 0 8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <TextBlock Text="DNS-сервер" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding DnsOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="optBorder" CornerRadius="12" Margin="0,0,0,5" Padding="14,12"
                                            Background="{StaticResource Glass}" BorderBrush="Transparent" BorderThickness="1"
                                            Cursor="Hand" MouseLeftButtonUp="DnsOption_MouseLeftButtonUp">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="22"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="optTitle" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                            <Path Grid.Column="2" Data="M 0 4.5 L 3.5 8 L 10 1" Stroke="{StaticResource AccentHi}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="optBorder" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="optBorder" Property="Background" Value="{StaticResource GlassHover}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="optBorder" Property="Background" Value="#1F8B7DFF"/>
                                            <Setter TargetName="optBorder" Property="BorderBrush" Value="{StaticResource AccentStroke}"/>
                                            <Setter TargetName="optTitle" Property="Foreground" Value="{StaticResource AccentHi}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 6. DELETE-ALL CONFIRMATION (bottom sheet) -->
            <!-- ========================================================================= -->
            <Grid Visibility="{Binding ServerListVm.IsDeleteAllConfirmOpen, Converter={StaticResource BoolToVis}}"
                  Background="#B8050609" MouseDown="DeleteAllOverlay_MouseDown" Panel.ZIndex="100">
                <Border VerticalAlignment="Bottom" Margin="10,0,10,10"
                        Background="{StaticResource Surface}" BorderBrush="#2A2F42" BorderThickness="1" CornerRadius="22"
                        Padding="18,10,18,16" MouseDown="DnsModalCard_MouseDown">
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ServerListVm.IsDeleteAllConfirmOpen}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="60" To="0" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Border Width="38" Height="4" CornerRadius="2" Background="#33FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                        <Border Width="44" Height="44" CornerRadius="14" Background="#1FFB7185" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <Path Width="16" Height="18" Stretch="Uniform" Fill="{StaticResource Danger}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                        </Border>

                        <TextBlock Text="Очистить список серверов?" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <TextBlock Text="{Binding ServerListVm.DeleteAllConfirmText}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="Передумаете — нажмите «Отменить» в течение 10 секунд после удаления." FontSize="11" Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap" Margin="0,4,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource GhostBtn}" Content="Отмена"
                                    Command="{Binding ServerListVm.CancelDeleteAllCommand}"/>
                            <Button Grid.Column="2" Style="{StaticResource DangerBtn}" Content="Очистить"
                                    Command="{Binding ServerListVm.ConfirmDeleteAllCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 7. PROGRAM PICKER (bottom sheet) -->
            <!-- ========================================================================= -->
            <Grid Visibility="{Binding ExcludedAppsVm.IsPickerOpen, Converter={StaticResource BoolToVis}}"
                  Background="#B8050609" MouseDown="PickerOverlay_MouseDown" Panel.ZIndex="100">
                <Border VerticalAlignment="Bottom" Margin="10,0,10,10" MaxHeight="560"
                        Background="{StaticResource Surface}" BorderBrush="#2A2F42" BorderThickness="1" CornerRadius="22"
                        Padding="14,10,14,14" MouseDown="DnsModalCard_MouseDown">
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExcludedAppsVm.IsPickerOpen}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="60" To="0" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Width="38" Height="4" CornerRadius="2" Background="#33FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                        <DockPanel Grid.Row="1" Margin="4,0,0,10">
                            <Button Style="{StaticResource WinBtn}" Width="28" Height="28" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Command="{Binding ExcludedAppsVm.ClosePickerCommand}" ToolTip="Закрыть">
                                <Path Data="M 0 0 L 8 8 M 8 0 L 0 8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <TextBlock Text="Запущенные программы" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        </DockPanel>

                        <TextBox Grid.Row="2" Tag="Поиск по названию" Margin="0,0,0,10"
                                 Text="{Binding ExcludedAppsVm.Search, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid Grid.Row="3" MinHeight="120">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ExcludedAppsVm.PickerItems}" Margin="0,0,4,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ExcludedAppsVm.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Margin="0,0,0,5" Padding="10,8">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource CardButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                                <Setter Property="Opacity" Value="0.45"/>
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="уже в списке" FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                                               VerticalAlignment="Center" Margin="8,0,4,0"
                                                               Visibility="{Binding IsAdded, Converter={StaticResource BoolToVis}}"/>
                                                    <Image Source="{Binding Icon}" Width="22" Height="22" Margin="2,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding ProcessName}" FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="Ищу запущенные программы…" FontSize="12" Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding ExcludedAppsVm.IsLoadingPicker, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="Ничего не нашлось. Запустите программу или найдите её exe-файл."
                                       FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0"
                                       Visibility="{Binding ExcludedAppsVm.PickerIsEmpty, Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                        <Button Grid.Row="4" Style="{StaticResource GhostBtn}" Margin="0,10,0,0" Command="{Binding ExcludedAppsVm.BrowseCommand}"
                                Content="Найти exe-файл вручную…"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Hairline highlight around the whole window -->
            <Border CornerRadius="24" BorderBrush="#1FFFFFFF" BorderThickness="1" IsHitTestVisible="False" Panel.ZIndex="200"/>
        </Grid>
    </Grid>
</Window>
