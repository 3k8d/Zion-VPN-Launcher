<Window x:Class="Zion.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Zion.ViewModels"
        xmlns:screens="clr-namespace:Zion.Views.Screens"
        xmlns:sheets="clr-namespace:Zion.Views.Sheets"
        Title="Zion" Width="461" Height="696" MinHeight="696"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" Foreground="#F4F6FB"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanMinimize" FontFamily="Segoe UI Variable Text, Segoe UI, Inter, Arial"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        RenderOptions.BitmapScalingMode="HighQuality"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown">

    <!-- The window is only the frame: every screen and sheet lives in its own file
         (Views/Screens, Views/Sheets); colours and styles come from Views/Theme.xaml. -->

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- ================= Tray menu ================= -->
        <ContextMenu x:Key="TrayContextMenu">
            <ContextMenu.Template>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#151824" BorderBrush="#2A2F42" BorderThickness="1" CornerRadius="12" Padding="6" SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </ContextMenu.Template>
            <ContextMenu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#D5DAE8"/>
                    <Setter Property="FontSize" Value="12.5"/>
                    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Arial"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="14,8" Margin="0,1">
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#262B3D"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="Separator">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Separator">
                                <Border Height="1" Background="#262B3D" Margin="8,4"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="Открыть Zion" Click="TrayOpen_Click"/>
            <Separator/>
            <MenuItem Header="Подключить / Отключить" Click="TrayToggle_Click"/>
            <Separator/>
            <MenuItem Header="Выход" Click="TrayExit_Click"/>
        </ContextMenu>
    </Window.Resources>

    <!-- 18px transparent gutter around the window holds the soft shadow -->
    <Grid Margin="18">
        <Border CornerRadius="24" Background="#090A11">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.55"/>
            </Border.Effect>
        </Border>

        <Grid>
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,425,660" RadiusX="24" RadiusY="24"/>
            </Grid.Clip>

            <!-- Backdrop: deep gradient with a faint cool tint in the lower-left corner -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                        <GradientStop Color="#10111B" Offset="0"/>
                        <GradientStop Color="#08090F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Rectangle Width="460" Height="460" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-230,0,0,-250"
                       Fill="#5B8CFF" Opacity="0.24" IsHitTestVisible="False">
                <Rectangle.OpacityMask>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF000000" Offset="0"/>
                        <GradientStop Color="#66000000" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>

            <!-- Screens: one is visible at a time -->
            <screens:DashboardView Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVis}}"/>
            <screens:ServerListView Visibility="{Binding IsServerListVisible, Converter={StaticResource BoolToVis}}"/>
            <screens:ServerEditView Visibility="{Binding IsServerEditVisible, Converter={StaticResource BoolToVis}}"/>
            <screens:SettingsView Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}"/>
            <screens:SubscriptionsView Visibility="{Binding IsSubscriptionsVisible, Converter={StaticResource BoolToVis}}"/>
            <screens:ExcludedAppsView Visibility="{Binding IsExclusionsVisible, Converter={StaticResource BoolToVis}}"/>
            <screens:ExcludedSitesView Visibility="{Binding IsExcludedSitesVisible, Converter={StaticResource BoolToVis}}"/>

            <!-- Bottom sheets over the current screen -->
            <sheets:DnsSheet Panel.ZIndex="100" Visibility="{Binding IsDnsModalOpen, Converter={StaticResource BoolToVis}}"/>
            <sheets:DeleteAllSheet Panel.ZIndex="100" Visibility="{Binding ServerListVm.IsDeleteAllConfirmOpen, Converter={StaticResource BoolToVis}}"/>
            <sheets:ProgramPickerSheet Panel.ZIndex="100" Visibility="{Binding ExcludedAppsVm.IsPickerOpen, Converter={StaticResource BoolToVis}}"/>

            <!-- Hairline highlight around the whole window -->
            <Border CornerRadius="24" BorderBrush="#1FFFFFFF" BorderThickness="1" IsHitTestVisible="False" Panel.ZIndex="200"/>
        </Grid>
    </Grid>
</Window>