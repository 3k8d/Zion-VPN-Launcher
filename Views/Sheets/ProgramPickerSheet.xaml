<!-- Running programs to exclude from the VPN (bottom sheet) -->
<UserControl x:Class="Zion.Views.Sheets.ProgramPickerSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource SheetBackdrop}" MouseDown="Backdrop_MouseDown">
        <Border Style="{StaticResource SheetCard}" MaxHeight="560" Padding="14,10,14,14" MouseDown="Card_MouseDown">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SheetHandle}" Margin="0,0,0,12"/>

                <DockPanel Grid.Row="1" Margin="4,0,0,10">
                    <Button Style="{StaticResource WinBtn}" Width="28" Height="28" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Command="{Binding ExcludedAppsVm.ClosePickerCommand}" ToolTip="Закрыть">
                        <Path Data="M 0 0 L 8 8 M 8 0 L 0 8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <TextBlock Text="Запущенные программы" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                </DockPanel>

                <TextBox Grid.Row="2" Tag="Поиск по названию" Margin="0,0,0,10"
                         Text="{Binding ExcludedAppsVm.Search, UpdateSourceTrigger=PropertyChanged}"/>

                <Grid Grid.Row="3" MinHeight="120">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ExcludedAppsVm.PickerItems}" Margin="0,0,4,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ExcludedAppsVm.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Margin="0,0,0,5" Padding="10,8">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CardButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                        <Setter Property="Cursor" Value="Arrow"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="уже в списке" FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                                       VerticalAlignment="Center" Margin="8,0,4,0"
                                                       Visibility="{Binding IsAdded, Converter={StaticResource BoolToVis}}"/>
                                            <Image Source="{Binding Icon}" Width="22" Height="22" Margin="2,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ProcessName}" FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="Ищу запущенные программы…" FontSize="12" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ExcludedAppsVm.IsLoadingPicker, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="Ничего не нашлось. Запустите программу или найдите её exe-файл."
                               FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0"
                               Visibility="{Binding ExcludedAppsVm.PickerIsEmpty, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <Button Grid.Row="4" Style="{StaticResource GhostBtn}" Margin="0,10,0,0" Command="{Binding ExcludedAppsVm.BrowseCommand}"
                        Content="Найти exe-файл вручную…"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
