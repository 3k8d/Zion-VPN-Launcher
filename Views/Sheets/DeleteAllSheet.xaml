<!-- Confirmation before clearing the server list (bottom sheet) -->
<UserControl x:Class="Zion.Views.Sheets.DeleteAllSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource SheetBackdrop}" MouseDown="Backdrop_MouseDown">
        <Border Style="{StaticResource SheetCard}" Padding="18,10,18,16" MouseDown="Card_MouseDown">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <StackPanel>
                <Border Style="{StaticResource SheetHandle}" Margin="0,0,0,16"/>

                <Border Width="44" Height="44" CornerRadius="14" Background="#1FFB7185" HorizontalAlignment="Left" Margin="0,0,0,14">
                    <Path Width="16" Height="18" Stretch="Uniform" Fill="{StaticResource Danger}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                </Border>

                <TextBlock Text="Очистить список серверов?" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                <TextBlock Text="{Binding ServerListVm.DeleteAllConfirmText}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock Text="Передумаете — нажмите «Отменить» в течение 10 секунд после удаления." FontSize="11" Foreground="{StaticResource TextMuted}"
                           TextWrapping="Wrap" Margin="0,4,0,18"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource GhostBtn}" Content="Отмена"
                            Command="{Binding ServerListVm.CancelDeleteAllCommand}"/>
                    <Button Grid.Column="2" Style="{StaticResource DangerBtn}" Content="Очистить"
                            Command="{Binding ServerListVm.ConfirmDeleteAllCommand}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
