<!-- DNS server choice (bottom sheet) -->
<UserControl x:Class="Zion.Views.Sheets.DnsSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource SheetBackdrop}" MouseDown="Backdrop_MouseDown">
        <Border Style="{StaticResource SheetCard}" Padding="14,10,14,14" MouseDown="Card_MouseDown">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <StackPanel>
                <Border Style="{StaticResource SheetHandle}" Margin="0,0,0,12"/>

                <DockPanel Margin="4,0,0,12">
                    <Button Style="{StaticResource WinBtn}" Width="28" Height="28" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Command="{Binding CloseDnsModalCommand}" ToolTip="Закрыть">
                        <Path Data="M 0 0 L 8 8 M 8 0 L 0 8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <TextBlock Text="DNS-сервер" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding DnsOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="optBorder" CornerRadius="12" Margin="0,0,0,5" Padding="14,12"
                                    Background="{StaticResource Glass}" BorderBrush="Transparent" BorderThickness="1"
                                    Cursor="Hand" MouseLeftButtonUp="DnsOption_MouseLeftButtonUp">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="optTitle" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Path Grid.Column="2" Data="M 0 4.5 L 3.5 8 L 10 1" Stroke="{StaticResource AccentHi}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="optBorder" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="optBorder" Property="Background" Value="{StaticResource GlassHover}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="optBorder" Property="Background" Value="#1F8B7DFF"/>
                                    <Setter TargetName="optBorder" Property="BorderBrush" Value="{StaticResource AccentStroke}"/>
                                    <Setter TargetName="optTitle" Property="Foreground" Value="{StaticResource AccentHi}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
